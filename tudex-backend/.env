# =====================================================
# Tudex Games Backend - Variables de Entorno
# Copia este archivo como .env y edita los valores
# =====================================================

# Base URL del servidor (usada para construir URLs de archivos)
BASE_URL=https://launcher.tudexgames.com

# JWT Secret (¡cambia esto en producción!)
JWT_SECRET=tudex-jwt-super-secret-cambia-esto-en-produccion

# PostgreSQL
DB_HOST=db
DB_PORT=5432
DB_USER=tudex
DB_PASS=tudex_secret_2026
DB_NAME=tudex_launcher

# Directorio de subida de archivos
UPLOAD_DIR=/app/uploads

# Puerto de la API
PORT=3000

# Entorno
NODE_ENV=production
